    "list": [
      {
        "name": "machine",
        "label": "Máquina",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "telemetry"
        },
        "query": "SELECT id AS __value, name AS __text FROM machine ORDER BY id",
        "definition": "SELECT id AS __value, name AS __text FROM machine ORDER BY id",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "type": "stat",
      "title": "Estado agora",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT si.state AS \"Estado\",\n       CASE WHEN si.state = 'FAULT' THEN coalesce(fc.description, 'Falha ' || si.fault_code)\n            ELSE to_char(now() - si.started_at, 'HH24:MI') || ' neste estado' END AS \"Detalhe\"\nFROM state_interval si\nLEFT JOIN fault_code fc ON fc.machine_id = si.machine_id AND fc.code = si.fault_code\nWHERE si.machine_id = '$machine' AND si.ended_at IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "RUNNING": {
                  "text": "Produzindo",
                  "color": "green",
                  "index": 0
                },
                "IDLE": {
                  "text": "Parada",
                  "color": "yellow",
                  "index": 1
                },
                "FAULT": {
                  "text": "Em falha",
                  "color": "red",
                  "index": 2
                },
                "NO_DATA": {
                  "text": "Sem dados",
                  "color": "gray",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Detalhe"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "transparent"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "horizontal",
        "text": {
          "valueSize": 26
        }
      }
    },
