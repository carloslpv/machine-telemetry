    {
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry"
      },
      "type": "state-timeline",
      "title": "Linha do tempo de estados",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT greatest(started_at, $__timeFrom()) AS time, state AS \"Estado\"\nFROM state_interval\nWHERE machine_id = '$machine' AND started_at < $__timeTo() AND coalesce(ended_at, now()) > $__timeFrom()\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "RUNNING": {
                  "text": "Produzindo",
                  "color": "green",
                  "index": 0
                },
                "IDLE": {
                  "text": "Parada",
                  "color": "yellow",
                  "index": 1
                },
                "FAULT": {
                  "text": "Em falha",
                  "color": "red",
                  "index": 2
                },
                "NO_DATA": {
                  "text": "Sem dados",
                  "color": "gray",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": []
