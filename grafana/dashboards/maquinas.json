            "uid": "telemetry"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(recorded_at, '1h'), sum(good) AS \"Bons\", sum(reject) AS \"Refugos\"\nFROM production WHERE machine_id = '$machine' AND $__timeFilter(recorded_at)\nGROUP BY 1 ORDER BY 1"
        }
