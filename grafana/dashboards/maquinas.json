          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT description AS \"Causa\", round((sum(seconds) / 60)::numeric, 1) AS \"Minutos\"\nFROM machine_stops('$machine', $__timeFrom(), $__timeTo())\nGROUP BY description ORDER BY 2 DESC"
