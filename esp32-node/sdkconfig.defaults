# Settings every build starts from. Wi-Fi, broker and identity are not here: set them with `idf.py menuconfig`
# (menu "machine-telemetry node"); the generated sdkconfig is ignored by git so passwords never reach the repository.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
