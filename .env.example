# Copy to .env and fill in (.env is ignored by git). Every value is required.

# PostgreSQL: the platform's user, and the read-only user Grafana queries with
DB_PASSWORD=
GRAFANA_DB_PASSWORD=

# Mosquitto users (mosquitto/acl): the platform, the demo gateway, and an operator account
MQTT_PLATFORM_PASSWORD=
MQTT_GATEWAY_PASSWORD=
MQTT_ADMIN_PASSWORD=

# REST API key (X-API-Key), at least 16 characters
PLATFORM_API_KEY=

# TTN webhook: the token set as the X-Webhook-Token header of the webhook, and the TTN application id
TTN_WEBHOOK_TOKEN=
TTN_APPLICATION_ID=tcc-carlos

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=
