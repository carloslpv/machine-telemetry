# Copy to .env and fill in (.env is ignored by git). Every value is required, except the optional ones at the end.

# PostgreSQL: the platform's user, and the read-only user Grafana queries with
DB_PASSWORD=
GRAFANA_DB_PASSWORD=

# Mosquitto users (mosquitto/acl): the platform, the demo gateway, and an operator account
MQTT_PLATFORM_PASSWORD=
MQTT_GATEWAY_PASSWORD=
MQTT_ADMIN_PASSWORD=

# REST API key (X-API-Key), at least 16 characters
PLATFORM_API_KEY=

# TTN webhook: the token set as the X-Webhook-Token header of the webhook, and the TTN application id
TTN_WEBHOOK_TOKEN=
TTN_APPLICATION_ID=tcc-carlos

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=

# Optional. Password of the ESP32 node (esp32-node), user node-maleta-01; leave empty if there is none.
MQTT_NODE_PASSWORD=

# Optional. Ports on this computer, when the defaults are taken (for the demo case: MQTT_PORT=1884, next to
# cold-monitor-edge's broker on 1883).
# MQTT_PORT=1883
# PLATFORM_PORT=8080
# GRAFANA_PORT=3000
